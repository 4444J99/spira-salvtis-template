---
/**
 * WorldMotif — subtle ambient motion specks expressing a node's IconWorld.
 *
 * Three accent-tinted specks animate with the node's own ParticleBehavior
 * signature (the same 8-way taxonomy the Three.js spiral physics uses),
 * paced by its thermal multiplier and drifting along its gravity vector —
 * `motionTokensFor()` in `src/data/icon-worlds.ts` is the single source.
 * Theme propagation across surfaces is the point: the world a particle
 * inhabits is the world the content inhabits.
 *
 * Purely decorative: aria-hidden, pointer-events-none, transform/opacity
 * only (GPU-composited), fully static under prefers-reduced-motion (specks
 * remain as faint accent tints, no movement). Mount inside a `relative`
 * + `overflow-hidden` container (the heroes all are).
 */
import { motionTokensFor } from '../data/icon-worlds';

interface Props {
  nodeId: number;
}

const { nodeId } = Astro.props;
const m = motionTokensFor(nodeId);
---

<div
  class:list={['mw', m.behaviorClass]}
  style={m.style}
  aria-hidden="true"
  data-world-motif={nodeId}
>
  <i class="mw-s mw-s1"></i>
  <i class="mw-s mw-s2"></i>
  <i class="mw-s mw-s3"></i>
</div>

<style>
  .mw {
    position: absolute;
    inset: 0;
    'pointer-events': none;
    'z-index': 0;
  }
  .mw-s {
    position: absolute;
    display: block;
    'border-radius': 9999px;
  }
  .mw-s1 {
    left: 16%;
    top: 28%;
    width: 7px;
    height: 7px;
    background: var(--mw-a1);
    opacity: 0.26;
    'box-shadow': 0 0 14px var(--mw-a1);
  }
  .mw-s2 {
    left: 79%;
    top: 22%;
    width: 5px;
    height: 5px;
    background: var(--mw-a2);
    opacity: 0.2;
    'box-shadow': 0 0 10px var(--mw-a2);
  }
  .mw-s3 {
    left: 64%;
    top: 70%;
    width: 4px;
    height: 4px;
    background: var(--mw-a3);
    opacity: 0.16;
    'box-shadow': 0 0 8px var(--mw-a3);
  }

  /* Motion only when the visitor allows it — otherwise the specks rest as
     static accent tints (the theme still reads, just doesn't move). */
  @media (prefers-reduced-motion: no-preference) {
    .mw .mw-s {
      'animation-duration': var(--mw-dur);
      'animation-iteration-count': infinite;
      'animation-timing-function': ease-in-out;
    }
    /* Negative delays start each speck mid-cycle so nothing pops on load. */
    .mw .mw-s1 {
      'animation-delay': calc(var(--mw-dur) * -0.05);
    }
    .mw .mw-s2 {
      'animation-delay': calc(var(--mw-dur) * -0.38);
    }
    .mw .mw-s3 {
      'animation-delay': calc(var(--mw-dur) * -0.71);
    }

    /* floaty — zero-g wander */
    .mw-floaty .mw-s {
      'animation-name': mw-kf-floaty;
    }
    /* crystalline — re-anchoring between cardinal points */
    .mw-crystalline .mw-s {
      'animation-name': mw-kf-crystalline;
    }
    /* rising — heat-lift loop (drift vector carries the lift) */
    .mw-rising .mw-s {
      'animation-name': mw-kf-rising;
    }
    /* spiraling — upright circular orbit */
    .mw-spiraling .mw-s {
      'animation-name': mw-kf-orbit;
    }
    /* lattice — discrete grid re-seats (steps, not glides) */
    .mw-lattice .mw-s {
      'animation-name': mw-kf-lattice;
      'animation-timing-function': steps(1, end);
    }
    /* tidal — sideways swell with a low bob */
    .mw-tidal .mw-s {
      'animation-name': mw-kf-tidal;
    }
    /* radial-emission — pulse outward and dissolve */
    .mw-radial-emission .mw-s {
      'animation-name': mw-kf-emit;
    }
    /* dual-gyre — counter-rotating populations: middle speck reverses */
    .mw-dual-gyre .mw-s {
      'animation-name': mw-kf-orbit;
    }
    .mw-dual-gyre .mw-s2 {
      'animation-direction': reverse;
    }
  }

  @keyframes mw-kf-floaty {
    0%,
    100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(
        calc(9px + var(--mw-dx)),
        calc(-11px + var(--mw-dy))
      );
    }
    66% {
      transform: translate(calc(-7px + var(--mw-dx)), calc(7px + var(--mw-dy)));
    }
  }
  @keyframes mw-kf-crystalline {
    0%,
    100% {
      transform: translate(6px, 0) scale(1);
    }
    22% {
      transform: translate(0, 6px) scale(1.18);
    }
    47% {
      transform: translate(-6px, 0) scale(1);
    }
    72% {
      transform: translate(0, -6px) scale(1.18);
    }
  }
  @keyframes mw-kf-rising {
    0% {
      transform: translateY(calc(12px - var(--mw-dy)));
      opacity: 0;
    }
    25% {
      opacity: 0.3;
    }
    75% {
      opacity: 0.18;
    }
    100% {
      transform: translateY(calc(-14px + var(--mw-dy)));
      opacity: 0;
    }
  }
  @keyframes mw-kf-orbit {
    from {
      transform: rotate(0deg) translateX(9px) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translateX(9px) rotate(-360deg);
    }
  }
  @keyframes mw-kf-lattice {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.24;
    }
    25% {
      transform: translate(7px, 0);
      opacity: 0.14;
    }
    50% {
      transform: translate(7px, 7px);
      opacity: 0.24;
    }
    75% {
      transform: translate(0, 7px);
      opacity: 0.14;
    }
  }
  @keyframes mw-kf-tidal {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(11px, calc(2px + var(--mw-dy)));
    }
    75% {
      transform: translate(-11px, calc(-2px + var(--mw-dy)));
    }
  }
  @keyframes mw-kf-emit {
    0% {
      transform: scale(0.55);
      opacity: 0.34;
    }
    70% {
      transform: scale(1.45);
      opacity: 0.06;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
</style>
