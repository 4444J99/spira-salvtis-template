---
/**
 * DemoModal.astro — Intercepts sanitized /demo links & external placeholder CTAs.
 *
 * Provides meaningful interactive feedback explaining the integration architecture
 * instead of letting visitors hit a dead end or 404 trap on placeholder URLs.
 */
---

<div
  id="demo-integration-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden transition-opacity"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="demo-modal-title"
>
  <div
    class="glass-card max-w-lg w-full p-6 sm:p-8 border border-ocean-500/40 rounded-2xl shadow-2xl relative overflow-y-auto max-h-[90vh]"
  >
    <button
      id="demo-modal-close-btn"
      class="absolute top-5 right-5 text-white/40 hover:text-white text-xl p-2 rounded-lg hover:bg-white/10 transition-colors cursor-pointer"
      aria-label="Close modal"
    >
      &times;
    </button>

    <div class="mb-5">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ocean-500/10 border border-ocean-500/20 text-ocean-400 text-[11px] uppercase tracking-[0.15em] font-medium mb-3"
      >
        <span>⚡</span>
        <span>Simulated Integration Sandbox</span>
      </div>
      <h2
        id="demo-modal-title"
        class="font-heading text-[26px] font-light text-white leading-tight"
      >
        Sanitized Integration Architecture
      </h2>
      <p class="text-white/50 text-[13px] font-light mt-2 leading-relaxed">
        This link represents an external affiliate or CRM integration endpoint
        that has been sanitized for public template presentation.
      </p>
    </div>

    <div
      class="bg-ocean-950/80 border border-white/10 rounded-xl p-4 mb-5 text-[13px] space-y-2 font-mono"
    >
      <div class="flex justify-between items-start gap-2">
        <span class="text-white/40 shrink-0">Endpoint:</span>
        <span id="demo-target-url" class="text-ocean-300 break-all text-right"
          >https://ionfaucet.com/demo</span
        >
      </div>
      <div
        class="flex justify-between items-center text-[12px] pt-2 border-t border-white/10"
      >
        <span class="text-white/40">Status:</span>
        <span class="text-emerald-400 font-medium">200 OK (Simulated)</span>
      </div>
      <div class="flex justify-between items-center text-[12px]">
        <span class="text-white/40">Payload:</span>
        <span class="text-gold-light font-medium">Encrypted Lead JSON</span>
      </div>
    </div>

    <!-- Simulated Payload View -->
    <div
      id="demo-payload-container"
      class="hidden mb-5 bg-black/50 border border-ocean-500/20 rounded-xl p-3.5 text-[12px] font-mono text-ocean-200 overflow-x-auto"
    >
      <pre
        id="demo-payload-code"
        class="whitespace-pre-wrap">{`{
  "event": "integration_handshake",
  "template": "spira-salvtis",
  "status": "sanitized_demo",
  "timestamp": "2026-06-22T00:00:00Z"
}`}</pre>
    </div>

    <div class="space-y-2.5">
      <button
        id="btn-simulate-webhook"
        class="w-full py-3 px-4 rounded-lg bg-ocean-500 hover:bg-ocean-400 text-white font-medium text-[13px] transition-all cursor-pointer flex items-center justify-center gap-2"
      >
        <span>Test Webhook Payload Response</span>
      </button>

      <button
        id="btn-copy-specs"
        class="w-full py-3 px-4 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white/80 font-medium text-[13px] transition-all cursor-pointer flex items-center justify-center gap-2"
      >
        <span>Copy Integration Architecture Specs</span>
      </button>

      <button
        id="demo-modal-dismiss-btn"
        class="w-full py-2.5 px-4 rounded-lg text-white/40 hover:text-white/80 font-medium text-[12px] transition-all cursor-pointer"
      >
        Close Preview
      </button>
    </div>

    <p
      id="demo-toast"
      class="mt-3 text-center text-[11px] text-gold-light hidden"
      aria-live="polite"
    >
      Specs copied to clipboard!
    </p>
  </div>
</div>

<script>
  function initDemoModal() {
    const modal = document.getElementById('demo-integration-modal');
    if (!modal) return;

    const targetUrlEl = document.getElementById('demo-target-url');
    const closeBtn = document.getElementById('demo-modal-close-btn');
    const dismissBtn = document.getElementById('demo-modal-dismiss-btn');
    const simulateBtn = document.getElementById('btn-simulate-webhook');
    const copyBtn = document.getElementById('btn-copy-specs');
    const payloadContainer = document.getElementById('demo-payload-container');
    const toast = document.getElementById('demo-toast');

    function openModal(href: string) {
      if (targetUrlEl) targetUrlEl.textContent = href;
      modal?.classList.remove('hidden');
      modal?.setAttribute('aria-hidden', 'false');
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.setAttribute('aria-hidden', 'true');
      payloadContainer?.classList.add('hidden');
      if (toast) toast.classList.add('hidden');
    }

    closeBtn?.addEventListener('click', closeModal);
    dismissBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    simulateBtn?.addEventListener('click', () => {
      payloadContainer?.classList.toggle('hidden');
    });

    copyBtn?.addEventListener('click', async () => {
      const href = targetUrlEl?.textContent || '';
      const specs = `[Spira Integration Architecture Spec]\nEndpoint: ${href}\nStatus: Sanitized Demo Sandbox\nMode: Client IP Protection Active`;
      try {
        await navigator.clipboard.writeText(specs);
        if (toast) {
          toast.textContent = 'Architecture specs copied to clipboard!';
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 3000);
        }
      } catch {
        if (toast) {
          toast.textContent = 'Specs ready in preview above.';
          toast.classList.remove('hidden');
        }
      }
    });

    // Delegate click interceptor for all /demo links or [data-demo-link]
    document.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement)?.closest('a');
      if (!target) return;

      const href = target.getAttribute('href');
      if (!href) return;

      // Intercept any link pointing to a /demo URL or marked as demo
      if (
        href.includes('/demo') ||
        href.includes('demo') ||
        target.hasAttribute('data-demo-link') ||
        (href.startsWith('https://') && href.includes('leadconnectorhq.com'))
      ) {
        event.preventDefault();
        openModal(href);
      }
    });
  }

  // Run on DOM loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDemoModal);
  } else {
    initDemoModal();
  }
</script>
