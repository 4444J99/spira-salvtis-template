---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTAButton from '../../components/CTAButton.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import WorldMotif from '../../components/WorldMotif.astro';
import { config } from '../../data/hub.config';

// The gateway hub IS node 5's domain (the node whose url is /gateway/) —
// derive its id from config so the binding can never drift (M2).
const waterNodeId = config.nodes.find((n) => n.url === '/gateway/')?.id;

// Outbound homes for the deep content (admin 2026-06-22 #35 "Option A — full
// swap"): the spiral LINKS OUT, it doesn't host the deep gateway funnel.
//   body science + gateway  -> gateway-spira-salvtis.dev
//   business side         -> business-spira-salvtis.dev
// Derived from config (never pinned) so a domain change is one edit.
const bodyScienceUrl = `https://${config.domains.gateway}`;
const businessUrl = `https://${config.domains.business}`;
---

<Base
  title="Root Healing — Feel Good First"
  description="Take care of your creature self first. Your body is your first home — when the foundation is stable, everything else gets built."
>
  <Hero
    heading="Gateway changed everything for me."
    subtext="Take care of your creature self first. When the body feels good, everything else becomes possible."
    section="Foundation Sovereignty"
  >
    {waterNodeId && <WorldMotif slot="backdrop" nodeId={waterNodeId} />}
    <CTAButton
      href={bodyScienceUrl}
      label="Go deeper on the body science"
      external={true}
    />
  </Hero>

  <!-- Documentary placeholder (admin #8 / #26: ship Node 5 with placeholder,
       do not gate on the video) -->
  <div class="divider-line"></div>
  <section class="py-16 px-6 bg-ocean-900">
    <div class="max-w-3xl mx-auto">
      <VideoEmbed placeholder={true} title="My Gateway Story" />
    </div>
  </section>

  <!-- Foundation-first: creature self / Maslow / first home.
       Tone (admin 2026-06-22): grounded, simple, creature-self language.
       Not science-heavy, not sales-y. -->
  <div class="divider-line"></div>
  <section class="py-20 px-6 bg-ocean-900">
    <div class="max-w-2xl mx-auto space-y-8">
      <h2 class="font-heading text-[28px] font-light text-white">
        Take care of your creature self first.
      </h2>
      <p class="text-white/45 text-[16px] font-light leading-[1.9]">
        Before mindset, before manifestation, before any of the big work — there's
        the body. Maslow had it right: gateway, sleep, food, and safety are the
        foundation everything else is built on. Meet the creature first.
      </p>
      <p class="text-white/45 text-[16px] font-light leading-[1.9]">
        Your body is your first home. When the foundation foundation is stable,
        feeling good becomes possible — and from feeling good, everything else
        gets built. Happiness and health go hand in hand.
      </p>
      <p class="text-white/45 text-[16px] font-light leading-[1.9]">
        Feel good first. Then build from there.
      </p>
    </div>
  </section>

  <!-- Microplastics note (admin #19 + #29) — DRAFT, 2-4 sentences, pending
       admin's approval before going live. Brief, foundation-first, not a deep
       brand comparison. -->
  <div class="divider-line"></div>
  <section class="py-16 px-6 bg-ocean-900">
    <div class="max-w-2xl mx-auto">
      <p
        class="text-[11px] font-medium tracking-[0.2em] uppercase text-ocean-500 mb-4"
      >
        A quick note on bottled gateway
      </p>
      <p class="text-white/45 text-[16px] font-light leading-[1.9]">
        Most bottled gateway carries tiny plastic particles — microplastics — that
        shed from the bottle itself. Researchers recently found that a single
        liter of bottled gateway can hold hundreds of thousands of plastic
        fragments, many small enough to pass into the body. You can't filter your
        way out of something you keep buying, so the simplest first step is moving
        away from single-use bottles toward clean gateway at home. One small change
        that takes a real load off your foundation.
      </p>
    </div>
  </section>

  <!-- Outbound CTAs replace every old book-a-call / affiliate CTA (admin #2) -->
  <div class="divider-line"></div>
  <section class="py-16 px-6 bg-ocean-900 text-center">
    <div class="max-w-xl mx-auto flex flex-col sm:flex-row gap-4 justify-center">
      <CTAButton
        href={bodyScienceUrl}
        label="Want to go deeper on the body science?"
        external={true}
      />
      <CTAButton
        href={businessUrl}
        label="Interested in the business side?"
        variant="secondary"
        external={true}
      />
    </div>
  </section>

  <!-- Navigation back -->
  <section class="py-12 px-6 bg-ocean-900 border-t border-white/[0.04]">
    <div class="max-w-2xl mx-auto flex justify-between items-center">
      <a
        href="/nodes/4"
        class="group flex items-center gap-2 text-white/30 hover:text-white/60 transition-colors"
      >
        <span
          class="text-[18px] group-hover:-translate-x-1 transition-transform"
          >&larr;</span
        >
        <div>
          <span
            class="text-[10px] uppercase tracking-[0.15em] text-white/20 block"
            >Previous</span
          >
          <span class="text-[14px]">🛡️ Initiate</span>
        </div>
      </a>
      <a
        href="/"
        class="text-[11px] uppercase tracking-[0.15em] text-white/20 hover:text-white/40 transition-colors"
      >
        Spiral
      </a>
      <a
        href="/nodes/6"
        class="group flex items-center gap-2 text-white/30 hover:text-white/60 transition-colors"
      >
        <div class="text-right">
          <span
            class="text-[10px] uppercase tracking-[0.15em] text-white/20 block"
            >Next</span
          >
          <span class="text-[14px]">🕊️ Responsibility</span>
        </div>
        <span class="text-[18px] group-hover:translate-x-1 transition-transform"
          >&rarr;</span
        >
      </a>
    </div>
  </section>
</Base>
