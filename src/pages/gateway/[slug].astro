---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTAButton from '../../components/CTAButton.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import CycleAwareness from '../../components/CycleAwareness.astro';
import ResearchAccordion from '../../components/ResearchAccordion.astro';
import VerticalSpine from '../../components/VerticalSpine.astro';
import EmailGate from '../../components/EmailGate.astro';
import { config } from '../../data/hub.config';
import { hasCycleLayer } from '../../data/cycle.config';

export async function getStaticPaths() {
  const branches = await getCollection('branches');
  return branches.map((branch) => ({
    params: { slug: branch.id },
    props: { branch },
  }));
}

const { branch } = Astro.props;
const { Content } = await render(branch);
const { title, emoji, hook, status, tone } = branch.data;
const ctaLabel = tone === 'soft' ? 'Explore gently' : 'Take Gateway Quiz';

const branchSlug = branch.id;
const branchConfig = config.branches.find((b) => b.slug === branchSlug);
const citationIds = branchConfig?.citationIds || [];
const hasCycleContent = hasCycleLayer(branchSlug);
---

<Base
  title={`${title} — Gateway`}
  description={hook ||
    `Explore ${title} — research-backed insights for your gateway and health journey.`}
>
  <VerticalSpine />
  <!-- Branch header — FREE (Layer 1) -->
  <section
    class="relative min-h-[60vh] flex flex-col items-center justify-center text-center px-6 py-24 glow-bg overflow-hidden"
  >
    <div class="relative text-6xl mb-6">{emoji}</div>
    <h1
      class="relative font-heading text-[clamp(40px,5vw,64px)] font-light text-white leading-[1.1] mb-6"
      style="text-shadow: 0 0 50px rgba(var(--color-ocean-500-rgb, 17, 154, 158),0.12);"
    >
      {title}
    </h1>
    <p
      class="relative font-heading italic text-white/45 text-[clamp(18px,2.5vw,24px)] leading-relaxed max-w-2xl"
    >
      {hook}
    </p>
  </section>

  <!-- Deep content — GATED (Layer 2) -->
  <div class="divider-line"></div>
  <section class="py-16 px-6 bg-ocean-900">
    <div class="max-w-[640px] mx-auto">
      {
        status === 'placeholder' ? (
          <ComingSoon title={title} emoji={emoji} />
        ) : (
          <EmailGate
            preview={`Research-backed deep dive into ${title.toLowerCase()} — what it means, where gateway fits, and what the science shows.`}
          >
            <div class="branch-content text-[16px] leading-[1.9]">
              <Content />
            </div>
            {hasCycleContent && (
              <CycleAwareness branchSlug={branchSlug} tone={tone} />
            )}
            <ResearchAccordion ids={citationIds} />
          </EmailGate>
        )
      }
    </div>
  </section>

  <!-- CTA — FREE (visible to drive conversion into diagnostic flow) -->
  <section class="py-20 px-6 glow-bg text-center border-t border-ocean-500/10">
    <div
      class="relative flex flex-col md:flex-row gap-4 justify-center items-center"
    >
      <CTAButton href="/gateway/quiz" label={ctaLabel} />
      <CTAButton href="/store" label="Gateway Systems" variant="secondary" />
      <CTAButton href="/gateway/" label="Back to Gateway" variant="secondary" />
    </div>
  </section>
</Base>
