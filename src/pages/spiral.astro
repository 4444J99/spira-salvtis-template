---
import Base from '../layouts/Base.astro';
import SpiralIsland from '../components/spiral/SpiralIsland.astro';
import SpiralFallback from '../components/spiral/SpiralFallback.astro';
import { config } from '../data/hub.config';
---

<Base
  title={`The Spiral — ${config.name}`}
  description="The immersive 13-node Spira salvtis Spiral: each node is a distinct world with its own boundary, matter, motion, and elemental field."
  hideBreadcrumbs
>
  <section
    class="spiral-landing relative min-h-[calc(100vh-56px)] overflow-hidden"
  >
    <div class="absolute inset-0 spiral-landing__field" aria-hidden="true">
    </div>
    <div class="absolute inset-x-0 top-0 z-10 px-6 pt-14 md:px-10 md:pt-20">
      <div class="mx-auto flex max-w-6xl items-start justify-between gap-8">
        <div class="spiral-landing__copy max-w-[18rem]">
          <h1
            class="font-heading text-[30px] font-light leading-tight text-white md:text-[42px]"
          >
            Spira salvtis Spiral
          </h1>
          <p
            class="mt-4 hidden text-[12px] font-light uppercase leading-6 tracking-[0.16em] text-white/45 sm:block"
          >
            Thirteen nodes. Distinct worlds. One living architecture.
          </p>
        </div>
        <a
          href="/quiz"
          class="hidden border-b border-cyan-300/50 pb-1 text-[10px] font-medium uppercase tracking-[0.18em] text-cyan-200/80 transition-colors hover:text-white md:inline-block"
        >
          Find your node
        </a>
      </div>
    </div>
    <div class="relative z-0">
      <SpiralIsland immersive />
      <SpiralFallback />
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-32 bg-gradient-to-t from-ocean-900 to-transparent"
      aria-hidden="true"
    >
    </div>
  </section>
</Base>

<style>
  .spiral-landing {
    background:
      radial-gradient(
        circle at 68% 34%,
        rgba(33, 126, 154, 0.1),
        transparent 32rem
      ),
      radial-gradient(
        circle at 20% 72%,
        rgba(221, 155, 72, 0.06),
        transparent 28rem
      ),
      var(--ss-page-bg, #020b10);
  }

  .spiral-landing__field {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(
      circle at 50% 42%,
      black 0%,
      black 54%,
      transparent 88%
    );
  }

  @media (max-width: 639px) {
    .spiral-landing__copy {
      position: relative;
      isolation: isolate;
    }

    .spiral-landing__copy::before {
      content: '';
      position: absolute;
      inset: -1.25rem -2rem -1rem -1.25rem;
      z-index: -1;
      background: radial-gradient(
        ellipse at 28% 45%,
        rgba(2, 11, 16, 0.94) 0%,
        rgba(2, 11, 16, 0.78) 48%,
        transparent 78%
      );
      filter: blur(4px);
    }
  }
</style>
