---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTAButton from '../../components/CTAButton.astro';
import WorldMotif from '../../components/WorldMotif.astro';
import { config } from '../../data/hub.config';
import type { SpiralNode } from '../../data/hub.config';
import { worldFor, hexToCss } from '../../data/icon-worlds';
import { visualForNode } from '../../data/node-visuals';

const allNodeContent = await getCollection('nodes');

export function getStaticPaths() {
  // Node 5 (Gateway) lives at /gateway/, not /nodes/5 — only nodes whose
  // canonical url is under /nodes/ get a page here (12 of the 13). Keying
  // off the url keeps the route set in lockstep with hub.config.
  return config.nodes
    .filter((node) => node.url.startsWith('/nodes/'))
    .map((node) => ({
      params: { id: String(node.id) },
      props: { node },
    }));
}

interface Props {
  node: SpiralNode;
}

const { node } = Astro.props;
const pillar = config.pillars.find((p) => p.slug === node.pillarSlug);
const phaseLabel = `${node.phase.charAt(0)}${node.phase.slice(1).toLowerCase()} Phase`;
const isLive = node.status === 'live';
const world = worldFor(node.id);
const visual = visualForNode(node.id);
const palette = world.accentPalette.map(hexToCss);
const nodeThemeStyle = [
  `--node-a1: ${palette[0]}`,
  `--node-a2: ${palette[1] ?? palette[0]}`,
  `--node-a3: ${palette[2] ?? palette[0]}`,
  `--node-a4: ${palette[3] ?? palette[0]}`,
  `--node-gas: ${world.phaseMix.gas}`,
  `--node-liquid: ${world.phaseMix.liquid}`,
  `--node-solid: ${world.phaseMix.solid}`,
  `--node-plasma: ${world.phaseMix.plasma}`,
  ...Object.entries(visual.cssVars).map(([key, value]) => `${key}: ${value}`),
].join('; ');
const nodeEnvClass = `node-vessel--${node.envVar.toLowerCase()}`;
const nodeVisualClass = `node-vessel--${visual.profileClass}`;
const generationOrder = visual.generationLaw.createOrder.join(',');
const phaseEntries = Object.entries(world.phaseMix).filter(
  ([, value]) => value > 0,
);
const dominantPhase = [...phaseEntries].sort((a, b) => b[1] - a[1])[0]?.[0];
const dominantMatter = phaseEntries
  .sort((a, b) => b[1] - a[1])
  .map(([name]) => name)
  .slice(0, 2)
  .join(' + ');
const nodeWorldHref = (n: SpiralNode) =>
  n.url.startsWith('/nodes/') ? n.url : `/nodes/${n.id}`;
const nodeActivation =
  node.pillarSlug === 'foundation'
    ? {
        eyebrow: 'Continue from here',
        title: 'Bring the work into the body.',
        body: 'Start with the gateway pathway and turn the node into a concrete next step.',
        primaryHref: '/gateway/quiz',
        primaryLabel: 'Take the Gateway Quiz',
        secondaryHref: '/quiz',
        secondaryLabel: 'Retake Spiral Quiz',
      }
    : node.pillarSlug === 'vision'
      ? {
          eyebrow: 'Continue from here',
          title: 'Turn clarity into systems.',
          body: 'Move from the spiral into the business pathway for time, money, and offer structure.',
          primaryHref: '/business/',
          primaryLabel: 'Explore Business',
          secondaryHref: '/quiz',
          secondaryLabel: 'Retake Spiral Quiz',
        }
      : {
          eyebrow: 'Continue from here',
          title: 'Find the live doorway.',
          body: 'Use the assessment to locate the open node that can hold this layer right now.',
          primaryHref: '/quiz',
          primaryLabel: 'Find Your Starting Point',
          secondaryHref: pillar?.url,
          secondaryLabel: pillar ? `Explore ${pillar.name}` : undefined,
        };

// Content collection lookup
const nodeContent = allNodeContent.find((c) => c.data.nodeId === node.id);
const hasContent = !!nodeContent;
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let data: CollectionEntry<'nodes'>['data'] | null = null;
if (nodeContent) {
  const rendered = await render(nodeContent);
  Content = rendered.Content;
  data = nodeContent.data;
}

// Sequential navigation
const allNodes = config.nodes;
const currentIndex = allNodes.findIndex((n) => n.id === node.id);
const prevNode = currentIndex > 0 ? allNodes[currentIndex - 1] : null;
const nextNode =
  currentIndex < allNodes.length - 1 ? allNodes[currentIndex + 1] : null;
---

<Base
  title={`${node.name} — ${config.name}`}
  description={data?.intention || node.tagline}
>
  <div class="node-world" style={nodeThemeStyle}>
    <section
      class="node-hero relative isolate overflow-hidden px-6 py-24 md:px-10 md:py-32"
    >
      <WorldMotif nodeId={node.id} />
      <div class="node-hero__field absolute inset-0" aria-hidden="true"></div>
      <div
        class="relative z-10 mx-auto grid max-w-6xl gap-12 md:grid-cols-[minmax(0,0.88fr)_minmax(320px,0.72fr)] md:items-center"
      >
        <div>
          <p
            class="mb-5 text-[10px] font-medium uppercase tracking-[0.22em] text-white/35"
          >
            Node {node.id} / {phaseLabel}
          </p>
          <h1
            class="font-heading text-[46px] font-light leading-none text-white md:text-[76px]"
          >
            {node.name}
          </h1>
          <p
            class="mt-7 max-w-xl text-[18px] font-light leading-[1.8] text-white/55"
          >
            {node.tagline}
          </p>
          <div
            class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-[10px] uppercase tracking-[0.18em] text-white/38"
          >
            <span>{world.themeName}</span>
            <span>{dominantMatter}</span>
            <span>{world.biology}</span>
          </div>
        </div>

        <div
          class={`node-vessel node-vessel--${world.particleBehavior} node-vessel--dominant-${dominantPhase} ${nodeEnvClass} ${nodeVisualClass}`}
          data-node-id={node.id}
          data-render-law={visual.generationLaw.orbitBias}
          data-create-order={generationOrder}
          data-particle-budget={visual.generationLaw.particleBudget}
          data-turbulence={visual.generationLaw.turbulence}
          aria-hidden="true"
        >
          <div class="node-vessel__membrane">
            <span class="node-vessel__core"></span>
            <span class="node-vessel__current node-vessel__current--one"></span>
            <span class="node-vessel__current node-vessel__current--two"></span>
            <span class="node-vessel__boundary"></span>
            <span class="node-vessel__stars node-vessel__stars--one"></span>
            <span class="node-vessel__stars node-vessel__stars--two"></span>
            <span class="node-vessel__matter node-vessel__matter--gas"></span>
            <span class="node-vessel__matter node-vessel__matter--liquid"
            ></span>
            <span class="node-vessel__matter node-vessel__matter--solid"></span>
            <span class="node-vessel__matter node-vessel__matter--plasma"
            ></span>
            <span class="node-vessel__phase-field" aria-hidden="true"></span>
            <span class="node-vessel__nested" aria-hidden="true">
              <span class="node-vessel__chamber node-vessel__chamber--gas">
                <span class="node-vessel__chamber node-vessel__chamber--liquid">
                  <span
                    class="node-vessel__chamber node-vessel__chamber--solid"
                  >
                    <span
                      class="node-vessel__chamber node-vessel__chamber--plasma"
                    ></span>
                  </span>
                </span>
              </span>
            </span>
            <span class="node-vessel__generated" aria-hidden="true"></span>
            <span class="node-vessel__lattice"></span>
            <span class="node-vessel__meniscus"></span>
            <span class="node-vessel__veil"></span>
            <span class="node-vessel__corona"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="node-material px-6 py-10 md:px-10">
      <div
        class="mx-auto grid max-w-6xl gap-7 border-y border-white/[0.06] py-8 md:grid-cols-[0.8fr_1fr] md:items-center"
      >
        <div>
          <p
            class="text-[10px] font-medium uppercase tracking-[0.2em] text-white/25"
          >
            Interior matter
          </p>
          <p
            class="mt-3 font-heading text-[26px] font-light leading-tight text-white/72"
          >
            {visual.boundaryPrinciple}
          </p>
          <p class="mt-4 text-[15px] font-light leading-[1.8] text-white/42">
            {visual.matterPrinciple}
          </p>
          <p class="mt-3 text-[11px] uppercase tracking-[0.18em] text-white/28">
            {visual.colorStory}
          </p>
        </div>
        <div class="grid gap-3">
          {
            phaseEntries.map(([phase, value]) => (
              <div class="node-phase-row">
                <span>{phase}</span>
                <i style={`--phase-width: ${(value * 100).toFixed(0)}%`} />
                <em>{(value * 100).toFixed(0)}%</em>
              </div>
            ))
          }
          <p class="node-container-rule">{visual.containerRule}</p>
        </div>
      </div>
    </section>

    {
      isLive && hasContent ? (
        <section class="py-20 px-6">
          <div class="max-w-2xl mx-auto">
            {/* Sub-header quote */}
            {data?.subHeader && (
              <p class="font-heading text-[20px] italic text-ocean-400 text-center mb-12 leading-relaxed">
                {data.subHeader}
              </p>
            )}

            {/* Intention box */}
            {data?.intention && (
              <div class="mb-12">
                <p class="text-[10px] uppercase tracking-[0.2em] text-white/20 mb-3">
                  Intention
                </p>
                <div
                  class="glass-card p-6 sm:p-8"
                  style="border-color: rgba(var(--color-ocean-500-rgb, 17, 154, 158),0.12);"
                >
                  <p class="font-heading text-[18px] font-light text-white/70 leading-[1.7]">
                    {data.intention}
                  </p>
                </div>
              </div>
            )}

            {/* Markdown body content (Content is null when no markdown entry exists) */}
            {Content && (
              <div class="prose-node text-white/45 text-[16px] font-light leading-[1.9] mb-12">
                <Content />
              </div>
            )}

            {/* Core steps */}
            {data?.steps && data.steps.length > 0 && (
              <div class="mb-12">
                <p class="text-[10px] uppercase tracking-[0.2em] text-white/20 mb-6">
                  Core Steps
                </p>
                <div class="space-y-6">
                  {data.steps.map((step, i) => (
                    <div class="flex gap-4">
                      <span class="font-heading text-[28px] text-white/10 leading-none mt-1">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <div>
                        <h3 class="text-white/80 text-[16px] font-medium mb-2">
                          {step.title}
                        </h3>
                        <p class="text-white/40 text-[15px] font-light leading-[1.8]">
                          {step.text}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Practice table (Science / Sacred / Soul) */}
            {data?.practiceTable && data.practiceTable.length > 0 && (
              <div class="mb-12">
                <p class="text-[10px] uppercase tracking-[0.2em] text-white/20 mb-4">
                  Practice
                </p>
                <div class="overflow-x-auto">
                  <table class="w-full text-[13px] border-collapse">
                    <thead>
                      <tr class="border-b border-white/10">
                        <th class="text-left py-3 px-2 text-[10px] uppercase tracking-[0.1em] text-white/25 font-medium">
                          Science
                        </th>
                        <th class="text-left py-3 px-2 text-[10px] uppercase tracking-[0.1em] text-white/25 font-medium">
                          Sacred
                        </th>
                        <th class="text-left py-3 px-2 text-[10px] uppercase tracking-[0.1em] text-white/25 font-medium">
                          Soul Practice
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.practiceTable.map((row) => (
                        <tr class="border-b border-white/5">
                          <td class="py-3 px-2 text-white/35 font-light">
                            {row.science}
                          </td>
                          <td class="py-3 px-2 text-white/35 font-light font-heading italic">
                            {row.sacred}
                          </td>
                          <td class="py-3 px-2 text-ocean-400/70 font-medium">
                            {row.soul}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* Tools table (Tool / Purpose / Sacred) */}
            {data?.toolsTable && data.toolsTable.length > 0 && (
              <div class="mb-12">
                <p class="text-[10px] uppercase tracking-[0.2em] text-white/20 mb-4">
                  Regulation Tools
                </p>
                <div class="overflow-x-auto">
                  <table class="w-full text-[13px] border-collapse">
                    <thead>
                      <tr class="border-b border-white/10">
                        <th class="text-left py-3 px-2 text-[10px] uppercase tracking-[0.1em] text-white/25 font-medium">
                          Tool
                        </th>
                        <th class="text-left py-3 px-2 text-[10px] uppercase tracking-[0.1em] text-white/25 font-medium">
                          Purpose
                        </th>
                        <th class="text-left py-3 px-2 text-[10px] uppercase tracking-[0.1em] text-white/25 font-medium">
                          Sacred Mirror
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.toolsTable.map((row) => (
                        <tr class="border-b border-white/5">
                          <td class="py-3 px-2 text-ocean-400/70 font-medium">
                            {row.tool}
                          </td>
                          <td class="py-3 px-2 text-white/35 font-light">
                            {row.purpose}
                          </td>
                          <td class="py-3 px-2 text-white/35 font-light font-heading italic">
                            {row.sacred}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* Reflection prompts */}
            {data?.reflectionPrompts && data.reflectionPrompts.length > 0 && (
              <div class="mb-12">
                <p class="text-[10px] uppercase tracking-[0.2em] text-white/20 mb-4">
                  Reflection
                </p>
                <div
                  class="glass-card p-6 sm:p-8 text-center"
                  style="border-color: rgba(var(--color-ocean-500-rgb, 17, 154, 158),0.08);"
                >
                  {data.reflectionPrompts.map((prompt: string) => (
                    <p class="font-heading text-[18px] italic text-white/50 leading-[1.7] mb-3 last:mb-0">
                      "{prompt}"
                    </p>
                  ))}
                </div>
              </div>
            )}

            {/* Closing line */}
            {data?.closingLine && (
              <p class="font-heading text-[20px] font-light text-white/60 text-center leading-relaxed mt-12">
                {data.closingLine}
              </p>
            )}
          </div>
        </section>
      ) : isLive ? (
        <section class="py-20 px-6">
          <div class="max-w-2xl mx-auto">
            <p class="text-white/45 text-[16px] font-light leading-[1.9]">
              {node.tagline}
            </p>
          </div>
        </section>
      ) : (
        <section class="py-20 px-6">
          <div class="max-w-md mx-auto text-center">
            <div
              class="glass-card p-10"
              style="border-color: rgba(var(--color-ocean-500-rgb, 17, 154, 158),0.15);"
            >
              <div class="w-10 h-px bg-ocean-500/30 mx-auto mb-6" />
              <p class="text-[48px] mb-4">{node.emoji}</p>
              <h2 class="font-heading text-[24px] font-light text-white mb-3">
                Coming Soon
              </h2>
              <p class="text-white/35 text-[15px] font-light leading-relaxed mb-8">
                This node is part of the {phaseLabel}. It will unlock as the
                spiral grows.
              </p>
              {pillar && (
                <CTAButton
                  href={pillar.url}
                  label={`Explore ${pillar.name}`}
                  variant="secondary"
                />
              )}
            </div>
          </div>
        </section>
      )
    }

    {/* Activation CTA — prevents node pages from ending as cul-de-sacs. */}
    <section class="px-6 py-16 border-t border-white/[0.04]">
      <div class="mx-auto max-w-2xl text-center">
        <p
          class="text-[10px] font-medium uppercase tracking-[0.2em] text-white/20"
        >
          {nodeActivation.eyebrow}
        </p>
        <h2
          class="mt-4 font-heading text-[clamp(28px,4vw,40px)] font-light text-white/82"
        >
          {nodeActivation.title}
        </h2>
        <p class="mx-auto mt-4 max-w-md text-[15px] font-light leading-[1.8] text-white/42">
          {nodeActivation.body}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <CTAButton
            href={nodeActivation.primaryHref}
            label={nodeActivation.primaryLabel}
          />
          {
            nodeActivation.secondaryHref && nodeActivation.secondaryLabel && (
              <CTAButton
                href={nodeActivation.secondaryHref}
                label={nodeActivation.secondaryLabel}
                variant="secondary"
              />
            )
          }
        </div>
      </div>
    </section>

    {/* Lineage link — surface name to True Name to chain of traditions */}
    <section class="py-10 px-6 border-t border-white/[0.04]">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-[10px] uppercase tracking-[0.2em] text-white/20 mb-3">
          Substrate
        </p>
        <a
          href={`/lineage/${node.envVar.toLowerCase()}`}
          class="inline-block group"
        >
          <span
            class="font-heading text-[28px] font-light text-white/65 group-hover:text-white tracking-wide transition-colors"
          >
            {node.envVar}
          </span>
          <p
            class="mt-2 text-[12px] text-white/30 group-hover:text-ocean-400/70 uppercase tracking-[0.15em] transition-colors"
          >
            See lineage across traditions &rarr;
          </p>
        </a>
      </div>
    </section>

    {/* Sequential navigation */}
    <section class="py-12 px-6 border-t border-white/[0.04]">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center justify-between">
          {
            prevNode ? (
              <a
                href={nodeWorldHref(prevNode)}
                class="group flex items-center gap-2 text-white/30 hover:text-white/60 transition-colors"
              >
                <span class="text-[18px] group-hover:-translate-x-1 transition-transform">
                  &larr;
                </span>
                <div class="text-right">
                  <span class="text-[10px] uppercase tracking-[0.15em] text-white/20 block">
                    Previous
                  </span>
                  <span class="text-[14px]">
                    {prevNode.emoji} {prevNode.name}
                  </span>
                </div>
              </a>
            ) : (
              <div />
            )
          }
          <a
            href="/spiral"
            class="text-[11px] uppercase tracking-[0.15em] text-white/20 hover:text-white/40 transition-colors"
          >
            Spiral
          </a>
          {
            nextNode ? (
              <a
                href={nodeWorldHref(nextNode)}
                class="group flex items-center gap-2 text-white/30 hover:text-white/60 transition-colors"
              >
                <div>
                  <span class="text-[10px] uppercase tracking-[0.15em] text-white/20 block">
                    Next
                  </span>
                  <span class="text-[14px]">
                    {nextNode.emoji} {nextNode.name}
                  </span>
                </div>
                <span class="text-[18px] group-hover:translate-x-1 transition-transform">
                  &rarr;
                </span>
              </a>
            ) : (
              <div />
            )
          }
        </div>
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (() => {
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const vessels = document.querySelectorAll('[data-render-law]');

    const biasPoint = (bias, phase, random) => {
      if (bias === 'lens') return [18 + random() * 64, 42 + random() * 20];
      if (bias === 'split') {
        const left = random() > 0.5;
        return [
          left ? 22 + random() * 18 : 60 + random() * 18,
          22 + random() * 56,
        ];
      }
      if (bias === 'rise') return [38 + random() * 24, 72 - random() * 58];
      if (bias === 'threshold') return [32 + random() * 36, 26 + random() * 48];
      if (bias === 'void') return [18 + random() * 40, 28 + random() * 54];
      if (bias === 'lattice')
        return [
          24 + Math.round(random() * 4) * 12,
          20 + Math.round(random() * 4) * 14,
        ];
      if (bias === 'bloom') {
        const angle = random() * Math.PI * 2;
        const radius = phase === 'solid' ? 36 : 16 + random() * 34;
        return [50 + Math.cos(angle) * radius, 50 + Math.sin(angle) * radius];
      }
      if (bias === 'axis') return [45 + random() * 10, 18 + random() * 64];
      const angle = random() * Math.PI * 2;
      const radius = 12 + random() * 42;
      return [50 + Math.cos(angle) * radius, 50 + Math.sin(angle) * radius];
    };

    for (const vessel of vessels) {
      const field = vessel.querySelector('.node-vessel__generated');
      if (!field) continue;

      const nodeId = Number(vessel.dataset.nodeId || 1);
      const bias = vessel.dataset.renderLaw || 'radial';
      const order = (vessel.dataset.createOrder || 'gas,liquid,solid,plasma')
        .split(',')
        .filter(Boolean);
      const budget = Math.min(
        reducedMotion ? 14 : 30,
        Math.max(8, Number(vessel.dataset.particleBudget || 18)),
      );
      const turbulence = Math.max(0, Number(vessel.dataset.turbulence || 0.4));
      const seed =
        nodeId * 2654435761 +
        Math.floor(performance.now() * 1000) +
        Math.floor(Math.random() * 1000000);
      let state = seed >>> 0;
      const random = () => {
        state = (state * 1664525 + 1013904223) >>> 0;
        return state / 4294967296;
      };

      vessel.style.setProperty('--render-tilt', `${(random() - 0.5) * 18}deg`);
      vessel.style.setProperty('--render-drift', `${8 + random() * 20}px`);
      vessel.style.setProperty('--render-tempo', `${14 + random() * 18}s`);
      vessel.style.setProperty('--render-flow-a', `${random() * 360}deg`);
      vessel.style.setProperty('--render-flow-b', `${random() * 360}deg`);
      vessel.style.setProperty(
        '--render-field-scale',
        `${0.82 + random() * 0.36}`,
      );
      vessel.style.setProperty(
        '--render-field-warp',
        `${10 + random() * 28}px`,
      );

      const fragment = document.createDocumentFragment();
      for (let index = 0; index < budget; index += 1) {
        const phase = order[index % order.length] || 'gas';
        const atom = document.createElement('span');
        const [x, y] = biasPoint(bias, phase, random);
        const size =
          phase === 'solid'
            ? 4.2 + random() * 8.8
            : phase === 'liquid'
              ? 4.8 + random() * 10.4
              : phase === 'plasma'
                ? 3.2 + random() * 8.8
                : 2.8 + random() * 7.4;
        atom.className = `node-vessel__atom node-vessel__atom--${phase}`;
        atom.style.setProperty('--atom-x', `${x}%`);
        atom.style.setProperty('--atom-y', `${y}%`);
        atom.style.setProperty('--atom-size', `${size}px`);
        atom.style.setProperty(
          '--atom-drift-x',
          `${(random() - 0.5) * 16 * turbulence}px`,
        );
        atom.style.setProperty(
          '--atom-drift-y',
          `${(random() - 0.5) * 16 * turbulence}px`,
        );
        atom.style.setProperty('--atom-delay', `${random() * -18}s`);
