        translateX(calc(var(--atom-drift-x, 0px) * -0.32))
        translateY(calc(var(--atom-drift-y, 0px) * -0.22))
        scale(calc(0.72 + var(--atom-lfo-a, 1) * 0.14));
      opacity: 0.34;
    }
    50% {
      transform: translate(-50%, -50%)
        translate(
          calc(var(--atom-drift-x, 0px) * var(--atom-lfo-a, 1)),
          calc(var(--atom-drift-y, 0px) * var(--atom-lfo-b, 1))
        )
        scale(1.12);
      opacity: 0.84;
    }
    100% {
      transform: translate(
          calc(-50% + var(--atom-drift-x, 0px)),
          calc(-50% + var(--atom-drift-y, 0px))
        )
        rotate(calc(var(--atom-orbit, 0deg) * -1))
        scale(calc(0.92 + var(--atom-lfo-b, 1) * 0.22));
      opacity: 0.58;
    }
  }

