          <button type="button" data-save-draft>Save draft</button>
          <button type="button" data-reset-draft>Reset draft</button>
        </div>
      </header>

      <div class="studio-grid">
        <section class="preview-panel" aria-labelledby="preview-title">
          <div class="preview-head">
            <div>
              <p class="eyebrow" data-current-phase>INITIATE</p>
              <h2 id="preview-title" data-current-name>Feel Good First</h2>
            </div>
            <span class="status-pill" data-current-status>live</span>
          </div>

          <div class="universe-stage">
            <div class="universe-orb" data-preview-orb>
              <span class="orb-glow"></span>
              <span class="orb-boundary"></span>
              <span class="orb-core"></span>
              <span class="orb-liquid"></span>
              <span class="orb-solid"></span>
              <span class="orb-plasma"></span>
              <span class="orb-grid"></span>
              <span class="orb-particles" data-particle-field></span>
            </div>
          </div>

          <div class="structure-strip">
            <span>
              <small>EnvVar</small>
              <strong data-current-env>PYR</strong>
            </span>
            <span>
              <small>World</small>
              <strong data-current-world>Forge of Dawn</strong>
            </span>
            <span>
              <small>Lens</small>
