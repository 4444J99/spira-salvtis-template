  <textarea id="node-picker-data" hidden readonly>{pickerJson}</textarea>

  <script is:inline>
    const app = document.querySelector('[data-node-picker-app]');
    const dataEl = document.getElementById('node-picker-data');
    const records = JSON.parse(dataEl?.value || dataEl?.textContent || '[]');
    const storageKey = 'ss-node-picker-drafts:v1';
    const snapshotKey = 'ss-node-picker-snapshots:v1';
    const lastNodeKey = 'ss-node-picker-last-node:v1';
    const phases = ['gas', 'liquid', 'solid', 'plasma'];
    const lawBounds = {
      containment: { min: 0, max: 1 },
      permeability: { min: 0, max: 1 },
      viscosity: { min: 0, max: 1 },
      turbulence: { min: 0, max: 1 },
      density: { min: 0, max: 1 },
      burstChance: { min: 0, max: 0.006 },
      burstCycle: { min: 2, max: 8 },
      breathFreq: { min: 0.1, max: 1.6 },
      breathAmp: { min: 0.01, max: 0.12 },
      shimmerFreq: { min: 0.2, max: 2.4 },
      driftFreq: { min: 0.05, max: 0.8 },
      burstDrift: { min: 0.05, max: 0.3 },
    };
    const behaviorContainment = {
      lattice: 0.9,
      crystalline: 0.85,
      'dual-gyre': 0.6,
      tidal: 0.55,
      spiraling: 0.5,
      floaty: 0.45,
      rising: 0.4,
      'radial-emission': 0.3,
    };
    const sizeBiasDensity = {
      micro: 0.95,
      mixed: 0.75,
      macro: 0.55,
    };
    const numberPaths = new Set([
      'world.phaseMix.gas',
      'world.phaseMix.liquid',
      'world.phaseMix.solid',
      'world.phaseMix.plasma',
      'world.gravity.x',
      'world.gravity.y',
      'world.gravity.z',
      'world.thermalAmpMul',
      'visual.generationLaw.particleBudget',
      'visual.generationLaw.turbulence',
      'visual.cssVars.--v-refraction',
      'visual.cssVars.--v-boundary-weight',
      'visual.cssVars.--v-gas-scale',
      'visual.cssVars.--v-liquid-depth',
      'visual.cssVars.--v-solid-fracture',
      'visual.cssVars.--v-plasma-reach',
    ]);

    function deepClone(value) {
      return JSON.parse(JSON.stringify(value));
    }

    function loadDrafts() {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || '{}');
      } catch {
        return {};
      }
    }

    function saveDrafts() {
      localStorage.setItem(storageKey, JSON.stringify(drafts));
    }

    function loadSnapshots() {
      try {
        return JSON.parse(localStorage.getItem(snapshotKey) || '{}');
      } catch {
        return {};
      }
    }

    function getPath(target, path) {
      return path.split('.').reduce((cursor, key) => cursor?.[key], target);
    }

    function setPath(target, path, value) {
      const keys = path.split('.');
      const last = keys.pop();
      const parent = keys.reduce((cursor, key) => cursor[key], target);
      parent[last] = value;
    }

    function normalizePhaseMix(mix) {
      const total = phases.reduce(
        (sum, phase) => sum + Number(mix[phase] || 0),
        0,
      );
      if (!total) {
        return { gas: 0.25, liquid: 0.25, solid: 0.25, plasma: 0.25 };
      }
      return Object.fromEntries(
        phases.map((phase) => [
          phase,
          Number((Number(mix[phase] || 0) / total).toFixed(3)),
        ]),
      );
    }

    function clamp(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function cssNumber(value, fallback = 0) {
      const parsed = Number.parseFloat(String(value));
      return Number.isFinite(parsed) ? parsed : fallback;
    }

    function mulberry32(seed) {
      let s = seed | 0;
      return () => {
        s = (s + 0x6d2b79f5) | 0;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function envVarHash(envVar) {
      return Array.from(envVar).reduce(
        (hash, char) => Math.imul(hash ^ char.charCodeAt(0), 2654435761) >>> 0,
        2166136261,
      );
    }

    function deriveLifeMotionLawDraft(envVar, world) {
      const seed = envVarHash(envVar);
      const rng = mulberry32(seed);
      const mix = world.phaseMix;
      const heat = clamp((world.thermalAmpMul - 0.4) / 1.2, 0, 1);

      const containment = clamp(
        0.45 * behaviorContainment[world.particleBehavior] +
          0.45 * (mix.solid + 0.4 * mix.liquid) +
          rng() * 0.1,
        lawBounds.containment.min,
        lawBounds.containment.max,
      );
      const permeability = clamp(
        0.15 +
          0.55 * mix.gas +
          0.35 * mix.plasma -
          0.25 * mix.solid +
          rng() * 0.08,
        lawBounds.permeability.min,
        lawBounds.permeability.max,
      );
      const viscosity = clamp(
        0.15 + 0.6 * mix.liquid + 0.25 * mix.solid - 0.25 * heat + rng() * 0.06,
        lawBounds.viscosity.min,
        lawBounds.viscosity.max,
      );
      const turbulence = clamp(
        0.3 * mix.plasma + 0.2 * mix.gas + 0.4 * heat + rng() * 0.08,
        lawBounds.turbulence.min,
        lawBounds.turbulence.max,
      );
      const density = clamp(
        sizeBiasDensity[world.sizeBias] + (rng() - 0.5) * 0.1,
        lawBounds.density.min,
        lawBounds.density.max,
      );
      const polarity =
        world.gravity.y > 0.01
          ? 1
          : world.gravity.y < -0.01
            ? -1
            : seed % 2
              ? 1
              : -1;
      const burstChance = clamp(
        0.0004 + 0.0035 * mix.plasma + 0.002 * heat + rng() * 0.0004,
        lawBounds.burstChance.min,
        lawBounds.burstChance.max,
      );
      const burstCycle = clamp(
        2 + 5.5 * (1 - turbulence) + rng() * 0.5,
        lawBounds.burstCycle.min,
        lawBounds.burstCycle.max,
      );
      const breathFreq = clamp(
        (0.18 + 0.55 * heat) * (0.85 + rng() * 0.3),
        lawBounds.breathFreq.min,
        lawBounds.breathFreq.max,
      );
      const breathAmp = clamp(
        0.02 + 0.06 * permeability + rng() * 0.01,
        lawBounds.breathAmp.min,
        lawBounds.breathAmp.max,
      );
      const shimmerFreq = clamp(
        (0.4 + 1.5 * turbulence) * (0.85 + rng() * 0.3),
        lawBounds.shimmerFreq.min,
        lawBounds.shimmerFreq.max,
      );
      const driftSpan = lawBounds.driftFreq.max - lawBounds.driftFreq.min;
      const driftFreqs = Array.from({ length: 6 }, () =>
        clamp(
          lawBounds.driftFreq.min +
            driftSpan * (0.15 + 0.7 * rng()) * (0.5 + 0.5 * heat),
          lawBounds.driftFreq.min,
          lawBounds.driftFreq.max,
        ),
      );
      const burstDrift = Array.from({ length: 3 }, () =>
        clamp(
          0.05 + 0.25 * rng(),
          lawBounds.burstDrift.min,
          lawBounds.burstDrift.max,
        ),
      );

      return {
        envVar,
        seed,
        containment,
        permeability,
        viscosity,
        turbulence,
        density,
        polarity,
        burstChance,
        burstCycle,
        lfo: {
          breathFreq,
          breathAmp,
          shimmerFreq,
          driftFreqs,
          burstDrift,
        },
      };
    }

    function hexToInt(hex) {
      return `0x${String(hex).replace('#', '')}`;
    }

    function prettyLens(lens) {
      return String(lens)
        .split('-')
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(' ');
    }

    function lensFor(record, lens) {
      return (
        record.lensOptions.find((option) => option.lens === lens) ||
        record.lensOptions.find(
          (option) => option.lens === record.defaultLens,
        ) ||
        record.lensOptions[0]
      );
    }

    function polygonForPrimitive(primitive) {
      const vertices = Math.max(
        3,
        Math.min(18, Math.round(primitive.vertexCount)),
      );
      const rotation = Number(primitive.rotationPerSegment) || 0;
      const points = [];
      for (let index = 0; index < vertices; index += 1) {
        const angle =
          -Math.PI / 2 + rotation + (index * Math.PI * 2) / vertices;
        const twist =
          primitive.symmetry === 'fractal' && index % 2
            ? 0.82 + primitive.twistFactor * 0.1
            : 1;
        const x = 50 + Math.cos(angle) * 44 * twist;
        const y = 50 + Math.sin(angle) * 44 * twist;
        points.push(`${rounded(x, 2)}% ${rounded(y, 2)}%`);
      }
      return `polygon(${points.join(', ')})`;
    }

    function particleMarkup(draft, nodeId) {
      const budget = Math.max(
        8,
        Math.min(
          48,
          Math.round(Number(draft.visual.generationLaw.particleBudget) || 18),
        ),
      );
      const turbulence = Number(draft.visual.generationLaw.turbulence) || 0;
      const palette = draft.world.accentPalette;
      let html = '';
      for (let index = 0; index < budget; index += 1) {
        const angle = (index * 137.508 + nodeId * 17) % 360;
        const reverseAngle = -angle;
        const radius = 12 + ((index * 29 + nodeId * 7) % 42);
        const wobble = 4 + Math.round(turbulence * 18);
        const wobbleRise = Math.round(wobble * -0.72);
        const wobbleBack = Math.round(wobble * -0.58);
        const wobbleSettle = Math.round(wobble * 0.44);
        const size = 2 + ((index + nodeId) % 4);
        const glow = Math.round(size * 2.8);
        const color = palette[index % palette.length] || palette[0];
        const delay = (-index * 0.18).toFixed(2);
        html += `<i style="--p-angle:${angle}deg;--p-angle-rev:${reverseAngle}deg;--p-radius:${radius}%;--p-wobble:${wobble}px;--p-wobble-rise:${wobbleRise}px;--p-wobble-back:${wobbleBack}px;--p-wobble-settle:${wobbleSettle}px;--p-size:${size}px;--p-glow:${glow}px;--p-color:${color};--p-delay:${delay}s"></i>`;
      }
      return html;
    }

    function baseDraft(record) {
      return {
        world: deepClone(record.world),
        visual: deepClone(record.visual),
        lens: {
          binding: record.defaultLens,
        },
      };
    }

    function selectedRecord() {
      return (
        records.find((record) => record.node.id === selectedId) || records[0]
      );
    }

    function selectedDraft() {
      const record = selectedRecord();
      if (!drafts[selectedId]) drafts[selectedId] = baseDraft(record);
      if (!drafts[selectedId].world)
        drafts[selectedId].world = deepClone(record.world);
      if (!drafts[selectedId].visual)
        drafts[selectedId].visual = deepClone(record.visual);
      if (
        !drafts[selectedId].lens ||
        !record.lensOptions.some(
          (option) => option.lens === drafts[selectedId].lens.binding,
        )
      ) {
        drafts[selectedId].lens = { binding: record.defaultLens };
      }
      return drafts[selectedId];
    }

    function rounded(value, digits = 2) {
      return Number(value)
        .toFixed(digits)
        .replace(/\.?0+$/, '');
    }

    function setInputValues(draft) {
      app.querySelectorAll('[data-draft-path]').forEach((input) => {
        const path = input.dataset.draftPath;
        const value = getPath(draft, path);
        if (input.type === 'range') {
          input.value = String(cssNumber(value));
        } else {
          input.value = value ?? '';
        }
      });
    }

    function renderSpec(record, draft) {
      const phaseMix = normalizePhaseMix(draft.world.phaseMix);
      const selectedLens = lensFor(record, draft.lens.binding);
      const cssVars = Object.fromEntries(
        Object.entries(draft.visual.cssVars).map(([key, value]) => [
          key,
          String(value),
        ]),
      );
      const iconWorld = {
        themeName: draft.world.themeName,
        elements: draft.world.elements,
        phaseMix,
        biology: draft.world.biology,
        gravity: {
          x: Number(draft.world.gravity.x),
          y: Number(draft.world.gravity.y),
          z: Number(draft.world.gravity.z),
        },
        particleBehavior: draft.world.particleBehavior,
        accentPalette: draft.world.accentPalette.map(hexToInt),
        thermalAmpMul: Number(draft.world.thermalAmpMul),
        sizeBias: draft.world.sizeBias,
      };
      const lawWorld = {
        ...iconWorld,
        accentPalette: draft.world.accentPalette,
      };

      return {
        issue: 'GH#98',
        nodeId: record.node.id,
        name: record.node.name,
        envVar: record.node.envVar,
        lensBinding: {
          lens: selectedLens.lens,
          surfaceName: selectedLens.name,
          connotation: selectedLens.connotation,
          source: selectedLens.source,
          primitive: selectedLens.primitive,
        },
        lifeMotionLaw: deriveLifeMotionLawDraft(record.node.envVar, lawWorld),
        iconWorld,
        nodeVisual: {
          profileClass: draft.visual.profileClass,
          boundaryPrinciple: draft.visual.boundaryPrinciple,
          matterPrinciple: draft.visual.matterPrinciple,
          colorStory: draft.visual.colorStory,
          containerRule: draft.visual.containerRule,
          cssVars,
          generationLaw: {
            ...draft.visual.generationLaw,
            particleBudget: Math.round(
              Number(draft.visual.generationLaw.particleBudget),
            ),
            turbulence: Number(draft.visual.generationLaw.turbulence),
          },
        },
      };
    }

    function saveSnapshot() {
      const record = selectedRecord();
      const draft = selectedDraft();
      const snapshots = loadSnapshots();
      const savedAt = new Date().toISOString();
      snapshots[selectedId] = {
        savedAt,
        spec: renderSpec(record, draft),
      };
      localStorage.setItem(snapshotKey, JSON.stringify(snapshots));
      saveDrafts();
      return savedAt;
    }

    function downloadSpec() {
      const record = selectedRecord();
      const spec = app.querySelector('[data-export-spec]').textContent;
      const blob = new Blob([spec], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `node-${record.node.id}-universe-spec.json`;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    function render() {
      const record = selectedRecord();
      const draft = selectedDraft();
      const mix = normalizePhaseMix(draft.world.phaseMix);
      const palette = draft.world.accentPalette;
      const cssVars = draft.visual.cssVars;
      const selectedLens = lensFor(record, draft.lens.binding);
      const orb = app.querySelector('[data-preview-orb]');
      const field = app.querySelector('[data-particle-field]');

      app.querySelectorAll('[data-node-button]').forEach((button) => {
        button.classList.toggle(
          'is-active',
          Number(button.dataset.nodeButton) === selectedId,
        );
      });

      app.querySelector('[data-current-phase]').textContent = record.node.phase;
      app.querySelector('[data-current-name]').textContent = record.node.name;
      app.querySelector('[data-current-status]').textContent =
        record.node.status;
      app.querySelector('[data-current-env]').textContent = record.node.envVar;
      app.querySelector('[data-current-world]').textContent =
        draft.world.themeName;
      app.querySelector('[data-current-lens]').textContent = prettyLens(
        selectedLens.lens,
      );
      app.querySelector('[data-current-behavior]').textContent =
        draft.world.particleBehavior;
      app.querySelector('[data-current-surface-source]').textContent =
        prettyLens(selectedLens.lens);
      app.querySelector('[data-current-surface-name]').textContent =
        selectedLens.name;
      app.querySelector('[data-current-surface-connotation]').textContent =
        selectedLens.connotation;
      app.querySelector('[data-lens-vertices]').textContent = String(
        selectedLens.primitive.vertexCount,
      );
      app.querySelector('[data-lens-symmetry]').textContent =
        selectedLens.primitive.symmetry;
      app.querySelector('[data-lens-depth]').textContent = rounded(
        selectedLens.primitive.depthRatio,
      );

      app.querySelector('[data-node-page]').href = record.node.url;
      app.querySelector('[data-lineage-page]').href =
        `/lineage/${record.node.envVar.toLowerCase()}`;

      phases.forEach((phase) => {
        const percent = Math.round(mix[phase] * 100);
        app.querySelector(`[data-phase-bar="${phase}"]`).style.width =
          `${percent}%`;
        app.querySelector(`[data-phase-value="${phase}"]`).textContent =
          `${percent}%`;
      });

      orb.dataset.behavior = draft.world.particleBehavior;
      orb.dataset.orbit = draft.visual.generationLaw.orbitBias;
      orb.dataset.lens = selectedLens.lens;
      orb.style.setProperty('--pick-a1', palette[0]);
      orb.style.setProperty('--pick-a2', palette[1] || palette[0]);
      orb.style.setProperty('--pick-a3', palette[2] || palette[0]);
      orb.style.setProperty('--pick-a4', palette[3] || palette[0]);
      orb.style.setProperty('--pick-gas', mix.gas);
      orb.style.setProperty('--pick-liquid', mix.liquid);
      orb.style.setProperty('--pick-solid', mix.solid);
      orb.style.setProperty('--pick-plasma', mix.plasma);
      const refraction = cssNumber(cssVars['--v-refraction'], 1);
      const boundary = cssNumber(cssVars['--v-boundary-weight'], 0.8);
      const gasScale = cssNumber(cssVars['--v-gas-scale'], 1);
      const liquidDepth = cssNumber(cssVars['--v-liquid-depth'], 0.5);
      const solidFracture = cssNumber(cssVars['--v-solid-fracture'], 0.5);
      const plasmaReach = cssNumber(cssVars['--v-plasma-reach'], 0.5);
      orb.style.setProperty('--pick-refraction', refraction);
      orb.style.setProperty('--pick-boundary', boundary);
      orb.style.setProperty('--pick-gas-scale', gasScale);
      orb.style.setProperty('--pick-liquid-depth', liquidDepth);
      orb.style.setProperty('--pick-solid-fracture', solidFracture);
      orb.style.setProperty('--pick-plasma-reach', plasmaReach);
      orb.style.setProperty(
        '--pick-saturation',
        rounded(0.9 + refraction * 0.28, 3),
      );
      orb.style.setProperty(
        '--pick-glow-scale',
        rounded(0.86 + plasmaReach * 0.2, 3),
      );
      orb.style.setProperty(
        '--pick-boundary-px',
        `${rounded(1 + boundary * 2, 3)}px`,
      );
      orb.style.setProperty(
        '--pick-inset-glow',
        `${rounded(20 + refraction * 16, 3)}px`,
      );
      orb.style.setProperty(
        '--pick-out-glow',
        `${rounded(18 + boundary * 18, 3)}px`,
      );
      orb.style.setProperty(
        '--pick-boundary-opacity',
        rounded(0.36 + boundary * 0.34, 3),
      );
      orb.style.setProperty(
        '--pick-core-blur',
        `${rounded(2 + refraction * 2, 3)}px`,
      );
      orb.style.setProperty(
        '--pick-core-opacity',
        rounded(0.28 + mix.plasma * 0.58, 3),
      );
      orb.style.setProperty(
        '--pick-liquid-top',
        `${rounded(18 + (1 - liquidDepth) * 8, 3)}%`,
      );
      orb.style.setProperty(
        '--pick-liquid-opacity',
        rounded(0.14 + mix.liquid * 0.72, 3),
      );
      orb.style.setProperty(
        '--pick-liquid-scale',
        rounded(0.64 + liquidDepth * 0.28, 3),
      );
      orb.style.setProperty(
        '--pick-solid-border',
        `${rounded(1 + solidFracture * 1.4, 3)}px`,
      );
      orb.style.setProperty(
        '--pick-solid-opacity',
        rounded(0.08 + mix.solid * 0.78, 3),
      );
      orb.style.setProperty(
        '--pick-plasma-opacity',
        rounded(0.12 + mix.plasma * 0.66, 3),
      );
      orb.style.setProperty(
        '--pick-plasma-scale',
        rounded(0.74 + plasmaReach * 0.28, 3),
      );
      orb.style.setProperty(
        '--pick-grid-opacity',
        rounded(0.04 + mix.solid * 0.24, 3),
      );
      orb.style.setProperty(
        '--pick-rise-scale',
        rounded(0.78 + plasmaReach * 0.3, 3),
      );
      orb.style.setProperty(
        '--pick-rotation',
        cssVars['--v-rotation'] || '0deg',
      );
      orb.style.setProperty(
        '--pick-solid-polygon',
        polygonForPrimitive(selectedLens.primitive),
      );
      orb.style.setProperty(
        '--pick-depth-scale',
        rounded(0.82 + selectedLens.primitive.depthRatio * 0.28, 3),
      );
      field.innerHTML = particleMarkup(draft, record.node.id);

      setInputValues(draft);
      app.querySelectorAll('[data-control-value]').forEach((el) => {
        const value = getPath(draft, el.dataset.controlValue);
        el.textContent = rounded(cssNumber(value));
      });

      app.querySelector('[data-export-spec]').textContent = JSON.stringify(
        renderSpec(record, draft),
        null,
        2,
      );

      localStorage.setItem(lastNodeKey, String(selectedId));
    }

    let drafts = loadDrafts();
    const params = new URLSearchParams(window.location.search);
    const requestedNode = Number(params.get('node'));
    let selectedId = records.some((record) => record.node.id === requestedNode)
      ? requestedNode
      : Number(localStorage.getItem(lastNodeKey)) || records[0]?.node.id || 1;

    app.querySelectorAll('[data-node-button]').forEach((button) => {
      button.addEventListener('click', () => {
        selectedId = Number(button.dataset.nodeButton);
        const url = new URL(window.location.href);
        url.searchParams.set('node', String(selectedId));
        history.replaceState({}, '', url);
        render();
      });
    });

    app.querySelectorAll('[data-draft-path]').forEach((input) => {
      input.addEventListener('input', () => {
        const draft = selectedDraft();
        const path = input.dataset.draftPath;
        const value = numberPaths.has(path) ? Number(input.value) : input.value;
        setPath(draft, path, value);
        saveDrafts();
        render();
      });
    });

    app.querySelector('[data-reset-draft]').addEventListener('click', () => {
      delete drafts[selectedId];
      saveDrafts();
      render();
    });

    app
      .querySelector('[data-save-draft]')
      .addEventListener('click', (event) => {
        const button = event.currentTarget;
        saveSnapshot();
        button.textContent = 'Saved';
        window.setTimeout(() => {
          button.textContent = 'Save draft';
        }, 1200);
      });

    app
      .querySelector('[data-copy-spec]')
      .addEventListener('click', async (event) => {
        const button = event.currentTarget;
        const spec = app.querySelector('[data-export-spec]').textContent;
        await navigator.clipboard?.writeText(spec);
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = 'Copy spec';
        }, 1200);
      });

    app.querySelector('[data-download-spec]').addEventListener('click', () => {
      downloadSpec();
    });

    render();
  </script>
</Base>

