---
import Base from '../../layouts/Base.astro';
import { config } from '../../data/hub.config';
import { worldFor, hexToCss } from '../../data/icon-worlds';
import { visualForNode } from '../../data/node-visuals';
import { deriveLifeMotionLaw } from '../../data/life-motion-laws';
import {
  LENSES,
  defaultLensForEnvVar,
  modulatePrimitive,
} from '../../data/lens-geometry';
import { chainsFor } from '../../data/naming-chains';

const nodePickerData = config.nodes.map((node) => {
  const world = worldFor(node.id);
  const visual = visualForNode(node.id);
  const law = deriveLifeMotionLaw(node.envVar, world);
  const chain = chainsFor(node.envVar);
  const defaultLens = defaultLensForEnvVar(node.envVar);
  const lensOptions = LENSES.map((lens) => {
    const binding = chain.find((item) => item.lens === lens);

    return {
      lens,
      name: binding?.name ?? lens,
      connotation: binding?.connotation ?? '',
      source: binding?.source ?? '',
      primitive: modulatePrimitive(node.envVar, lens),
    };
  });

  return {
    node,
    world: {
      ...world,
      accentPalette: world.accentPalette.map(hexToCss),
    },
    visual,
    law,
    defaultLens,
    lensOptions,
  };
});

const pickerJson = JSON.stringify(nodePickerData);
---

<Base
  title={`Node Picker Admin - ${config.name}`}
  description="Internal node-universe picker for designing one Spira salvtis spiral node at a time."
  hideBreadcrumbs
  noindex
>
  <main class="node-picker" data-node-picker-app>
    <aside class="node-rail" aria-label="Spiral nodes">
      <div class="node-rail__header">
        <span>Node Picker</span>
        <strong data-node-count>{config.nodes.length}</strong>
      </div>
      <div class="node-rail__list">
        {
          nodePickerData.map(({ node, world }) => (
            <button
              type="button"
              class="node-button"
              data-node-button={node.id}
              style={`--node-color: ${node.color}; --node-world: ${world.accentPalette[0]};`}
            >
              <span>{String(node.id).padStart(2, '0')}</span>
              <strong>{node.name}</strong>
              <em>{node.phase}</em>
            </button>
          ))
        }
      </div>
    </aside>

    <section class="studio">
      <header class="studio-header">
        <div>
          <p class="eyebrow">Internal / GH#98</p>
          <h1>Node Universe Picker</h1>
        </div>
        <div class="studio-actions">
          <a href="/spiral?labels=always" target="_blank" rel="noopener">
            Live spiral
