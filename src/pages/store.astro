---
import Base from '../layouts/Base.astro';
import CTAButton from '../components/CTAButton.astro';
import WorldMotif from '../components/WorldMotif.astro';
import { config } from '../data/hub.config';

// Store delisted (admin 2026-06-22 #6, #25, #35 "Option A — full swap"):
// no affiliate water products (Kangen, K8, Coldstream, Multipure, Anespa, or any
// filter tiers) live on the spiral. The page + store.config.ts are PRESERVED so a
// first-party digital/membership shelf can be re-enabled later, but it no longer
// renders the affiliate catalog. The spiral links OUT instead.
//   body science + water -> water-spira-salvtis.dev
//   business side        -> business-spira-salvtis.dev
const bodyScienceUrl = `https://${config.domains.water}`;
const businessUrl = `https://${config.domains.business}`;
---

<Base
  title="Store — Sovereign Systems"
  description="Water systems and products now live on the water hub. The spiral links out."
>
  <main class="store-page">
    <header class="store-hero">
      <WorldMotif nodeId={13} />
      <p class="eyebrow">Water Systems</p>
      <h1>It's moved.</h1>
      <p class="intro">
        Water systems, filters, and the full body-science library now live on the
        water hub — so the spiral stays focused on the journey. Head over to go
        deeper, or explore the business side.
      </p>
      <div class="hero-actions">
        <CTAButton
          href={bodyScienceUrl}
          label="Go deeper on the body science"
          external={true}
        />
        <CTAButton
          href={businessUrl}
          label="Interested in the business side?"
          variant="secondary"
          external={true}
        />
        <CTAButton href="/spiral" label="Back to the Spiral" variant="secondary" />
      </div>
    </header>
  </main>
</Base>

<style>
  .store-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .store-hero {
    position: relative;
    min-height: 54vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    padding: 4rem 0 3rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    position: relative;
    margin: 0 0 0.65rem;
    color: var(--color-ocean-400);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    position: relative;
    margin: 0;
    color: white;
    font-weight: 300;
    font-size: clamp(2.9rem, 7vw, 5.7rem);
    line-height: 0.98;
    text-shadow: 0 0 60px rgba(var(--color-ocean-500-rgb, 17, 154, 158), 0.15);
  }

  .intro {
    position: relative;
    max-width: 650px;
    margin: 1.4rem auto 0;
    color: rgba(255, 255, 255, 0.54);
    font-size: 1rem;
    line-height: 1.8;
  }

  .hero-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.2rem;
  }
</style>
