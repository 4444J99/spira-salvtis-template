{
  "name": "sovereign-systems--spiral-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-citations-json.js && node scripts/generate-library-manifest.mjs",
    "build": "astro build",
    "check": "astro check",
    "pretest": "node scripts/generate-citations-json.js",
    "test": "node scripts/test.mjs",
    "test:all": "npm run test && npm run check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "astro": "astro",
    "parse-citations": "node scripts/parse-citations.js",
    "count-files": "node scripts/count-files.cjs",
    "deploy": "npm run test:all && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/sitemap": "3.7.3",
    "astro": "^6.4.8",
    "three": "0.184.0",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/workers-types": "^4.20260620.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/three": "0.184.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "wrangler": "^4.103.0"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "vite": "^7.3.3"
  }
}
